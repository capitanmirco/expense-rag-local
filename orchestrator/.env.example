PORT=3001

# ==============================================================================
# PROVIDER LLM — decommenta UNO solo dei tre blocchi qui sotto, compila i campi
# richiesti e lascia gli altri due blocchi commentati.
# Documentazione completa: README > Guida all'installazione
# ==============================================================================

# --- OPZIONE A: GitHub Copilot SDK -------------------------------------------
# Consigliato se hai una licenza GitHub Copilot (Individual / Business / Enterprise).
# Prerequisiti:
#   1. gh auth login                              (autenticazione GitHub CLI)
#   2. gh extension install github/gh-copilot    (estensione Copilot CLI)
# Modelli disponibili: gpt-4.1, gpt-4o, o4-mini, claude-sonnet-4.5, gemini-2.0-flash, ecc.
# Il frontend mostra il dropdown modelli e il monitor quota solo con questo provider.
#
# LLM_PROVIDER=copilot
# COPILOT_MODEL=gpt-4.1
# COPILOT_CLI_PATH=          # lascia vuoto se "copilot" è nel PATH di sistema
# COPILOT_GITHUB_TOKEN=      # lascia vuoto in sviluppo locale (usa il token di "gh auth login")

# --- OPZIONE B: Groq (cloud, API key) ----------------------------------------
# Tier gratuito generoso (~14.400 req/giorno). Registrati su https://console.groq.com
# Modelli consigliati: llama-3.3-70b-versatile | llama-3.1-8b-instant
#
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_CHANGE_ME
# GROQ_MODEL=llama-3.3-70b-versatile

# --- OPZIONE C: Ollama (completamente locale, nessuna API key) ----------------
# Nulla lascia la macchina. Prerequisiti: ollama serve + ollama pull <modello>
# Modelli: llama3.2 (~2 GB), llama3.1 (~4.9 GB), mistral (~4.1 GB)
# Aumenta LLM_TIMEOUT_MS se usi CPU (senza GPU la generazione è lenta).
#
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_TIMEOUT_MS=120000

# ==============================================================================
# PROVIDER ATTIVO — incolla qui il blocco decommentato e compilato sopra
# ==============================================================================
LLM_PROVIDER=groq
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama-3.3-70b-versatile

# Timeout risposta LLM in millisecondi (aumenta per modelli reasoning o Ollama su CPU)
LLM_TIMEOUT_MS=30000

# Variabili OpenAI-compatible generiche (usate da Opzione C o provider custom)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Copilot SDK — usate solo quando LLM_PROVIDER=copilot
COPILOT_MODEL=gpt-4.1
COPILOT_CLI_PATH=
COPILOT_GITHUB_TOKEN=

# ==============================================================================
# EMBEDDINGS
# ==============================================================================
# default-embed : locale, zero dipendenze, consigliato (Xenova/all-MiniLM-L6-v2)
# ollama-native : usa Ollama (richiede: ollama pull nomic-embed-text)
# openai-compat : usa /v1/embeddings sull'endpoint LLM_BASE_URL
#
# ATTENZIONE: se cambi provider o modello after aver già indicizzato documenti,
# cancella data/chroma/ (o orchestrator/data/fallback-store.json) e re-indicizza.
EMBEDDINGS_PROVIDER=default-embed
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
OLLAMA_URL=http://localhost:11434

# ==============================================================================
# VECTOR STORE
# ==============================================================================
# chroma : ChromaDB server locale (richiede Python 3.11 + pip install chromadb)
# local  : fallback file-based, zero dipendenze, adatto per sviluppo rapido
VECTOR_STORE=chroma
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=kb_store

# ==============================================================================
# RESTO DELLA CONFIGURAZIONE (non toccare salvo esigenze specifiche)
# ==============================================================================

# Nest API
API_BASE_URL=http://localhost:3000

# Tool backend: "api" (default) oppure "mcp"
TOOLS_BACKEND=api
MCP_URL=http://localhost:3400/rpc
MCP_PORT=3400

# Scope guardrail (demo)
SCOPE_DOMAIN=app demo
SCOPE_MIN_SCORE=0.2

# Router intent (spese vs documenti)
DOC_MIN_SCORE=0.2
EXPENSES_MIN_SCORE=0.2
DOC_K=4
EXPENSES_K=4
INTENT_DELTA=0.05
EXPENSES_CACHE_TTL_MS=30000

# Web Search
# Brave Search (https://api.search.brave.com — free tier 2000 req/mese) se la chiave è presente,
# altrimenti DuckDuckGo Instant Answer (gratuito, nessuna chiave richiesta).
# La ricerca è limitata al dominio finanziario (risparmio, budget, inflazione, mutui, tasse, ecc.)
WEBSEARCH_API_KEY=
