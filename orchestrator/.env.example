PORT=3001

# Vector store: "chroma" (server locale su http://localhost:8000) oppure "local" (fallback file-based)
VECTOR_STORE=chroma

# Chroma
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=kb_store

# Nest API
API_BASE_URL=http://localhost:3000

# Tool backend: "api" (default) oppure "mcp"
TOOLS_BACKEND=api
MCP_URL=http://localhost:3400/rpc
MCP_PORT=3400

# LLM provider: "groq" | "copilot" | altro OpenAI-compatible
# Usa "copilot" per sfruttare la licenza GitHub Copilot tramite @github/copilot-sdk
LLM_PROVIDER=groq

# Groq (usato quando LLM_PROVIDER=groq)
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=openai/gpt-oss-120b

# Override OpenAI-compatible (opzionale)
# LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embeddings: "default-embed" (locale, @chroma-core/default-embed), "openai-compat" (usa /v1/embeddings) oppure "ollama-native" (usa Ollama /api/embeddings)
EMBEDDINGS_PROVIDER=default-embed
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
OLLAMA_URL=http://localhost:11434

# Scope guardrail (demo)
SCOPE_DOMAIN=app demo
SCOPE_MIN_SCORE=0.2

# Router intent (spese vs documenti)
DOC_MIN_SCORE=0.2
EXPENSES_MIN_SCORE=0.2
DOC_K=4
EXPENSES_K=4
INTENT_DELTA=0.05
EXPENSES_CACHE_TTL_MS=30000

# --- Web Search ---
# Provider: Brave Search (https://api.search.brave.com - free tier 2000 req/mese)
# Se la chiave è vuota, usa DuckDuckGo Instant Answer (gratuito, nessuna chiave richiesta)
# La ricerca è limitata al dominio finanziario (risparmio, budget, inflazione, mutui, tasse, ecc.)
WEBSEARCH_API_KEY=

# --- Copilot SDK (usato quando LLM_PROVIDER=copilot) ---
# Modello da usare (es. gpt-4.1, gpt-5, claude-sonnet-4.5)
COPILOT_MODEL=gpt-4.1
# Token GitHub (opzionale: se omesso usa login CLI o variabile d'ambiente GH_TOKEN/GITHUB_TOKEN)
COPILOT_GITHUB_TOKEN=
# Path custom della CLI copilot (opzionale: se omesso cerca "copilot" nel PATH)
COPILOT_CLI_PATH=
